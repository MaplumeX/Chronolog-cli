{
  "name": "chronolog-cli",
  "version": "0.1.0",
  "description": "JSON-output CLI for AI agents to operate a Chronolog instance",
  "type": "module",
  "bin": {
    "chronolog": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"dist-test/test/*.test.js\""
  },
  "keywords": [
    "chronolog",
    "cli",
    "time-tracking",
    "ai-agents",
    "json"
  ],
  "author": "Maplume",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaplumeX/Chronolog-cli.git"
  },
  "bugs": {
    "url": "https://github.com/MaplumeX/Chronolog-cli/issues"
  },
  "homepage": "https://github.com/MaplumeX/Chronolog-cli#readme",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  }
}
